# Test and benchmark harness for lua-resty-surge.
#
# The module is not installed into the image. `make` mounts the repo at
# /work and runs busted, the smoke script, and ab against this OpenResty.
#
#   make image
#   make test
#   make smoke

ARG OPENRESTY_IMAGE=openresty/openresty:1.31.1.1-3-jammy
FROM ${OPENRESTY_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        perl \
        cpanminus \
        build-essential \
        git \
        ca-certificates \
        curl \
        unzip \
        procps \
        pkg-config \
        libssl-dev \
        apache2-utils \
    && rm -rf /var/lib/apt/lists/*

RUN cpanm --notest Test::Nginx

RUN luarocks install busted 2>&1 | tail -2 \
    && luarocks install lua-resty-http 2>&1 | tail -2 \
    && luarocks install lua-resty-ipmatcher 2>&1 | tail -2

# wrk links against the image's LuaJIT. OpenResty keeps those headers under
# include/luajit-2.1/; wrk looks for <prefix>/include.
RUN git clone --depth=1 https://github.com/wg/wrk.git /tmp/wrk \
    && mkdir -p /tmp/lj/include /tmp/lj/lib \
    && ln -s /usr/local/openresty/luajit/include/luajit-2.1/* /tmp/lj/include/ \
    && ln -s /usr/local/openresty/luajit/lib/* /tmp/lj/lib/ \
    && make -C /tmp/wrk -j"$(nproc)" WITH_LUAJIT=/tmp/lj \
    && cp /tmp/wrk/wrk /usr/local/bin/wrk \
    && rm -rf /tmp/wrk /tmp/lj

ENV PATH=/usr/local/openresty/luajit/bin:/usr/local/openresty/bin:/usr/local/openresty/nginx/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/usr/local/openresty/luajit/lib
ENV TEST_NGINX_BINARY=/usr/local/openresty/nginx/sbin/nginx
# `;;` keeps OpenResty's bundled lualib. The luajit share path is where
# luarocks put lua-resty-http and lua-resty-ipmatcher.
ENV LUA_PATH=/work/lib/?.lua;/work/lib/?/init.lua;/usr/local/openresty/luajit/share/lua/5.1/?.lua;/usr/local/openresty/luajit/share/lua/5.1/?/init.lua;;
ENV LUA_CPATH=/usr/local/openresty/luajit/lib/lua/5.1/?.so;;

WORKDIR /work
CMD ["/bin/bash"]
